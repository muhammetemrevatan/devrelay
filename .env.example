# Copy to .env for local configuration. Never commit actual credentials.
# Environment files are loaded only when explicitly supplied with --env-file.
DEVRELAY_CONTROL_ENVIRONMENT=development
DEVRELAY_CONTROL_HOST=127.0.0.1
DEVRELAY_CONTROL_PORT=8000
DEVRELAY_CONTROL_LOG_LEVEL=info

# Optional database integration. Migrations run only through an explicit command.
# DEVRELAY_CONTROL_DATABASE__HOST=127.0.0.1
# DEVRELAY_CONTROL_DATABASE__PORT=5432
# DEVRELAY_CONTROL_DATABASE__DATABASE=devrelay
# DEVRELAY_CONTROL_DATABASE__USERNAME=devrelay
# DEVRELAY_CONTROL_DATABASE__PASSWORD=replace-with-a-database-password
# DEVRELAY_CONTROL_DATABASE__SCHEMA_NAME=public
# DEVRELAY_CONTROL_DATABASE__POOL_SIZE=4
# DEVRELAY_CONTROL_DATABASE__SSLMODE=prefer

# Optional read-only Jira integration. Configure the whole group together.
# Scoped API tokens use api.atlassian.com/ex/jira/<cloud-id>.
# The cloud ID below is a placeholder; verify the real site's ID before use.
# DEVRELAY_CONTROL_JIRA__SITE_URL=https://your-site.atlassian.net
# DEVRELAY_CONTROL_JIRA__CLOUD_ID=11111111-2222-3333-4444-555555555555
# DEVRELAY_CONTROL_JIRA__EMAIL=reader@example.com
# DEVRELAY_CONTROL_JIRA__API_TOKEN=replace-with-a-read-only-api-token
# DEVRELAY_CONTROL_JIRA__TOKEN_MODE=scoped
# DEVRELAY_CONTROL_JIRA__ALLOWED_PROJECT_KEYS=["DRY"]
# DEVRELAY_CONTROL_JIRA__ACCEPTANCE_CRITERIA_FIELD=customfield_12345

# Optional operator import API. Requires complete Jira and database groups above.
# Generate a separate token using secrets.token_urlsafe(32); never reuse other secrets.
# DEVRELAY_CONTROL_TASK_IMPORT__AUTH_TOKEN=replace-with-a-generated-import-token
# DEVRELAY_CONTROL_TASK_IMPORT__MAX_CONCURRENT_REQUESTS=4
# DEVRELAY_CONTROL_TASK_IMPORT__BODY_TIMEOUT_SECONDS=5

# Optional submission preparation policy, inactive until explicitly enabled.
# Requires Jira/database settings; this does not expose a Job API or start work.
# UUID, repository and branch below are examples; assign/verify your own values.
# DEVRELAY_CONTROL_REPOSITORIES=[{"repository_id":"11111111-2222-3333-4444-555555555555","slug":"example/devrelay","enabled":false,"target_branch":"master","coding_branch_prefix":"devrelay/jobs","policy_version":"v1","allowed_project_keys":["DRY"],"checks":[{"id":"pytest","argv":["uv","run","--locked","pytest"],"working_directory":".","timeout_seconds":300}],"max_repair_cycles":2}]

# Optional control-owned GitHub observation, not submission authentication.
# Configure every repository UUID with its independently verified GitHub numeric ID.
# Use a separate read-only token with Metadata, Contents and Pull requests permissions.
# DEVRELAY_CONTROL_GITHUB__API_TOKEN=replace-with-a-read-only-github-token
# DEVRELAY_CONTROL_GITHUB__REPOSITORY_IDS=[{"repository_id":"11111111-2222-3333-4444-555555555555","github_id":123456789}]
# Numeric identity is verified per observation; durable numeric binding/dispatch are deferred.

# Worker enrollment and execution are not implemented yet.
# The following URL is suitable only for a local/protected tunnel.
DEVRELAY_WORKER_CONTROL_URL=http://127.0.0.1:8000
DEVRELAY_WORKER_AUTH_TOKEN=replace-with-an-enrolled-worker-token
DEVRELAY_WORKER_WORKSPACE_ROOT=./workspaces
DEVRELAY_WORKER_POLL_INTERVAL_SECONDS=5
