# syntax=docker/dockerfile:1
FROM python:3.14.8-slim-trixie
COPY --from=ghcr.io/astral-sh/uv:0.12.24 /uv /usr/local/bin/uv
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends git=1:2.47.3-0+deb13u1 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 devrelay \
    && useradd --uid 10001 --gid devrelay --no-create-home --shell /usr/sbin/nologin devrelay \
    && mkdir -p /opt/devrelay /opt/deps /workspace /runtime/auth /runtime/private \
    && chown 10001:10001 /workspace /runtime/auth /runtime/private \
    && chmod 0700 /runtime/auth /runtime/private
WORKDIR /opt/deps
COPY worker-runtime/install_codex.py /opt/devrelay/install_codex.py
RUN --mount=type=cache,target=/var/cache/devrelay-codex,sharing=locked python /opt/devrelay/install_codex.py
COPY pyproject.toml uv.lock .python-version README.md ./
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy PYTHONDONTWRITEBYTECODE=1
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked uv sync --locked --all-groups --no-install-project
COPY worker-runtime/entry.py worker-runtime/check.py worker-runtime/probe.py /opt/devrelay/
ENV PATH="/opt/deps/.venv/bin:/usr/local/bin:/usr/bin:/bin" \
    PYTHONUNBUFFERED=1 CODEX_HOME=/runtime/auth HOME=/tmp/home \
    UV_CACHE_DIR=/tmp/uv-cache
USER 10001:10001
WORKDIR /workspace
ENTRYPOINT ["/opt/deps/.venv/bin/python", "/opt/devrelay/entry.py"]
